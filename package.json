{
  "name": "omx-sdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Oxinion Marketing Exchange SDK (JavaScript & Python)",
  "scripts": {
    "build": "npm run build:js && npm run build:py",
    "build:js": "cd js && pnpm build",
    "build:py": "cd py && python -m build",
    "test": "npm run test:js && npm run test:py",
    "test:js": "cd js && pnpm test",
    "test:py": "cd py && python -m pytest",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "cd js && pnpm lint",
    "lint:py": "cd py && ruff check .",
    "format": "npm run format:js && npm run format:py",
    "format:js": "cd js && pnpm format",
    "format:py": "cd py && black . && ruff --fix .",
    "generate": "npm run generate:js && npm run generate:py",
    "generate:js": "cd js && pnpm generate",
    "generate:py": "openapi-python-client generate --path spec/openapi.yaml --output-path py/omx_sdk/shared/generated",
    "clean": "npm run clean:js && npm run clean:py",
    "clean:js": "cd js && pnpm clean",
    "clean:py": "cd py && rm -rf dist/ build/ *.egg-info/"
  },
  "keywords": [
    "oxinion",
    "marketing",
    "exchange", 
    "omx",
    "sdk",
    "monorepo",
    "javascript",
    "python"
  ],
  "author": "Oxinion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxinion/omx-sdk.git"
  },
  "homepage": "https://github.com/oxinion/omx-sdk#readme",
  "bugs": {
    "url": "https://github.com/oxinion/omx-sdk/issues"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.12"
  }
}