{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "../spec/openapi.yaml"],
  "pipeline": {
    "generate": {
      "inputs": ["../spec/openapi.yaml"],
      "outputs": ["packages/shared/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "../spec/openapi.yaml"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "../spec/openapi.yaml"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../spec/openapi.yaml"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}