{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": true,
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,

    "paths": {
      "@omx-sdk/core": ["./packages/core/src/index.ts"],
      "@omx-sdk/geotrigger": ["./packages/geotrigger/src/index.ts"],
      "@omx-sdk/email": ["./packages/email/src/index.ts"],
      "@omx-sdk/webhook": ["./packages/webhook/src/index.ts"],
      "@omx-sdk/notification": ["./packages/notification/src/index.ts"],
      "@omx-sdk/beacon": ["./packages/beacon/src/index.ts"],
      "@omx-sdk/campaign": ["./packages/campaign/src/index.ts"],
      "@omx-sdk/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
