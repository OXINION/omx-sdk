{
  "name": "omx-sdk",
  "version": "1.0.5",
  "description": "Complete SDK for Oxinion Marketing Exchange",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts", 
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./geotrigger": {
      "import": "./dist/geotrigger.js",
      "types": "./dist/geotrigger.d.ts"
    },
    "./email": {
      "import": "./dist/email.js", 
      "types": "./dist/email.d.ts"
    },
    "./webhook": {
      "import": "./dist/webhook.js",
      "types": "./dist/webhook.d.ts"
    },
    "./notification": {
      "import": "./dist/notification.js",
      "types": "./dist/notification.d.ts"
    },
    "./beacon": {
      "import": "./dist/beacon.js",
      "types": "./dist/beacon.d.ts"
    },
    "./campaign": {
      "import": "./dist/campaign.js",
      "types": "./dist/campaign.d.ts"
    },
    "./shared": {
      "import": "./dist/shared.js",
      "types": "./dist/shared.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vitest"
  },
  "dependencies": {},
  "keywords": [
    "oxinion",
    "marketing",
    "exchange",
    "omx",
    "sdk",
    "geotrigger",
    "email",
    "webhook",
    "push-notification",
    "geofencing",
    "beacon",
    "campaign",
    "automation",
    "location-based",
    "proximity-marketing"
  ],
  "author": "Oxinion",
  "license": "MIT",
  "homepage": "https://github.com/oxinion/omx-sdk#readme",
  "bugs": {
    "url": "https://github.com/oxinion/omx-sdk/issues"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oxinion/omx-sdk.git",
    "directory": "js/packages/meta/omx-sdk"
  }
}