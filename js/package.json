{
  "name": "omx-sdk-js",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript SDK for Oxinion Marketing Exchange",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "workspaces": [
    "packages/*",
    "packages/meta/*"
  ],
  "resolutions": {
    "file-type": "21.3.3"
  },
  "scripts": {
    "build": "pnpm run build:shared && pnpm run build:core && pnpm run build:features && pnpm run build:meta",
    "build:turbo": "turbo run build",
    "build:shared": "cd packages/shared && pnpm build",
    "build:core": "cd packages/core && pnpm build",
    "build:features": "cd packages/geotrigger && pnpm build && cd ../email && pnpm build && cd ../webhook && pnpm build && cd ../notification && pnpm build && cd ../beacon && pnpm build && cd ../campaign && pnpm build",
    "build:meta": "cd packages/meta/omx-sdk && pnpm build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "clean": "pnpm -r clean",
    "dev": "pnpm -r --parallel dev",
    "publish-packages": "pnpm build && changeset publish",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "publish-all": "pnpm -r publish --tag latest",
    "publish-all-dry": "pnpm -r publish --tag latest --dry-run",
    "generate": "openapi-generator-cli generate -i ../spec/openapi.yaml -g typescript-fetch -o ./packages/shared/src/generated"
  },
  "keywords": [
    "oxinion",
    "marketing",
    "exchange",
    "omx",
    "sdk",
    "geotrigger",
    "email",
    "webhook"
  ],
  "author": "Oxinion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxinion/omx-sdk.git",
    "directory": "js"
  },
  "homepage": "https://github.com/oxinion/omx-sdk#readme",
  "bugs": {
    "url": "https://github.com/oxinion/omx-sdk/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@openapitools/openapi-generator-cli": "^2.30.2",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^8.57.1",
    "eslint-config-love": "^62.0.1",
    "eslint-config-prettier": "^9.1.2",
    "file-type": "^21.3.3",
    "prettier": "^3.8.1",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
