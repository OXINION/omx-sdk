{
  "name": "@omx-sdk/core",
  "version": "1.0.2",
  "description": "Core module for OMX SDK with authentication and shared utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "demo": "node demo.mjs"
  },
  "keywords": [
    "omx",
    "sdk",
    "authentication",
    "supabase",
    "jwt",
    "typescript"
  ],
  "author": "OMX SDK Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxinion/omx-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/oxinion/omx-sdk#readme",
  "bugs": {
    "url": "https://github.com/oxinion/omx-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.37",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2"
  }
}
